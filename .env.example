# ─── OddsCraft env ───────────────────────────────────────────────
# Solana RPC (server-side tx building + broadcasting)
RPC_URL=https://api.devnet.solana.com
# Client-side RPC + cluster (wallet adapter network + explorer links)
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CLUSTER=devnet

# DBC config account that new conviction-token pools launch on.
# Create your own with meteora-invent: `pnpm studio dbc-create-config`
# (see README "Create your own curve config").
POOL_CONFIG_KEY=
NEXT_PUBLIC_POOL_CONFIG_KEY=

# Panta API key — self-serve: register at
# https://live-api.panta.market/api/v1/auth/register/ then POST /account/keys/ {"env":"test"}
# pk_test_ keys receive sandbox fixtures; pk_live_ keys hit the live API.
PANTA_API_KEY=
# PANTA_API_BASE_URL=https://live-api.panta.market/api/v1

# Public origin of this app (used to build absolute token metadata/image URLs).
# APP_ORIGIN=https://your-deploy.example
